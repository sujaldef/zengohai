# Audio Customer Support Agent - Configuration
# Copy this file to .env and fill in your actual API keys

# =============================================================================
# REQUIRED: Choose ONE LLM Provider
# =============================================================================

# OpenAI (for both STT and LLM)
OPENAI_API_KEY=sk-...
# Get your key at: https://platform.openai.com/api-keys

# OR Groq (for LLM only)
GROQ_API_KEY=gsk-...
# Get your key at: https://console.groq.com/keys

# =============================================================================
# LLM Configuration
# =============================================================================

# Model selection
# OpenAI options: gpt-4o-mini, gpt-4-turbo, gpt-4, gpt-3.5-turbo
# Groq options: llama2-70b-4096, mixtral-8x7b-32768, gemma-7b-it
LLM_MODEL=gpt-4o-mini

# Response quality (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.2

# =============================================================================
# Speech-to-Text (STT) Configuration
# =============================================================================

# Model selection
# "whisper-1"              → OpenAI Whisper API (requires OPENAI_API_KEY)
# "base"                   → Local Whisper (~140MB, ~15-30s per 3s audio)
# "small"                  → Local Whisper (~500MB, ~5-10s per 3s audio)
# "medium"                 → Local Whisper (~1.4GB, ~3-5s per 3s audio)
# "large"                  → Local Whisper (~2.9GB, ~1-2s per 3s audio)
STT_MODEL=base

# =============================================================================
# Text-to-Speech (TTS) Configuration
# =============================================================================

# Edge-TTS voice (used for all TTS)
# Examples: en-US-AriaNeural, en-US-GuyNeural, en-GB-SoniaNeural
# See https://learn.microsoft.com/en-us/azure/cognitive-services/speech-service/language-support?tabs=tts
EDGE_TTS_VOICE=en-US-AriaNeural

# =============================================================================
# Conversation Memory
# =============================================================================

# Number of conversation turns to keep in memory (6 = 12 messages: 6 user, 6 AI)
MEMORY_WINDOW=6

# =============================================================================
# Logging & Debug
# =============================================================================

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# Server Configuration (Optional)
# =============================================================================

# API server host and port
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8000

# =============================================================================
# Advanced: Provider Override (Optional)
# =============================================================================

# Explicitly set LLM provider (overrides auto-detection)
# Leave empty for auto-detection based on available keys
# LLM_PROVIDER=openai    # or "groq"

# =============================================================================
# Notes:
# =============================================================================
# - At least one API key (OPENAI_API_KEY or GROQ_API_KEY) is REQUIRED
# - STT with "whisper-1" requires OPENAI_API_KEY
# - STT with local models requires no API key
# - Edge-TTS works completely offline (no API key needed)
# - Knowledge base is auto-loaded from data/chroma_db/ on startup
